<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.dentim.karaoke.ui.player.PlayerViewModel" />
        <variable
            name="playbackState"
            type="com.dentim.karaoke.ui.player.PlaybackState" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Track Info Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <!-- Album Art Placeholder -->
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_music_note_24"
                        android:background="@drawable/dialog_background"
                        android:scaleType="centerInside"
                        android:padding="32dp" />

                    <!-- Track Title -->
                    <TextView
                        android:id="@+id/trackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{playbackState.trackTitle ?? @string/no_track_selected}"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"
                        tools:text="My Favorite Song" />

                    <!-- Artist Name -->
                    <TextView
                        android:id="@+id/artistName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{playbackState.artistName ?? @string/unknown_artist}"
                        android:textSize="16sp"
                        android:textColor="@android:color/darker_gray"
                        android:gravity="center"
                        tools:text="Unknown Artist" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Seek Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <SeekBar
                    android:id="@+id/progressSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="@{playbackState.progressPercent}"
                    android:layout_marginBottom="8dp"
                    tools:progress="30" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{playbackState.currentTimeFormatted}"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        tools:text="1:23" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/totalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{playbackState.totalTimeFormatted}"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray"
                        tools:text="3:45" />

                </LinearLayout>

            </LinearLayout>

            <!-- Playback Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <!-- Previous Button -->
                <ImageButton
                    android:id="@+id/previousButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="24dp"
                    android:enabled="false" />

                <!-- Play/Pause Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@{playbackState.isPlaying ? @drawable/ic_pause : @drawable/ic_play_arrow}"
                    android:layout_marginEnd="24dp"
                    app:fabSize="normal"
                    tools:src="@drawable/ic_play_arrow" />

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/nextButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:enabled="false" />

            </LinearLayout>

            <!-- Volume Controls Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_controls"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Vocals Volume -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_mic_24"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="@string/vocals_volume"
                            android:textSize="14sp" />

                        <SeekBar
                            android:id="@+id/vocalsVolumeSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="@{playbackState.vocalsVolume}"
                            android:layout_marginEnd="8dp"
                            tools:progress="70" />

                        <TextView
                            android:id="@+id/vocalsVolumeText"
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:text="@{String.valueOf(playbackState.vocalsVolume)}"
                            android:textSize="12sp"
                            android:gravity="end"
                            tools:text="70" />

                    </LinearLayout>

                    <!-- Instrumental Volume -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_music_note_24"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="@string/instrumental_volume"
                            android:textSize="14sp" />

                        <SeekBar
                            android:id="@+id/instrumentalVolumeSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="@{playbackState.instrumentalVolume}"
                            android:layout_marginEnd="8dp"
                            tools:progress="100" />

                        <TextView
                            android:id="@+id/instrumentalVolumeText"
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:text="@{String.valueOf(playbackState.instrumentalVolume)}"
                            android:textSize="12sp"
                            android:gravity="end"
                            tools:text="100" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Track Selection Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_track"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/selectTrackButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/choose_track"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>