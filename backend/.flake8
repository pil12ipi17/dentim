[flake8]
max-line-length = 88
extend-ignore = E203, E266, E501, W503, F403, F401
max-complexity = 18
select = B,C,E,F,W,T4,B9
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist,
    .mypy_cache,
    .pytest_cache

per-file-ignores =
    # Tests can have longer lines and unused imports
    tests/*:E501,F401,F811
    # __init__.py files can have unused imports
    __init__.py:F401